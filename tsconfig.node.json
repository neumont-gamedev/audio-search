{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "src/renderer/services/selection.ts",
    "src/renderer/services/destinations.ts",
    "src/renderer/services/waveform.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM"]
  }
}
